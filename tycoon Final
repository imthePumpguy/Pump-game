                id: 'cooling',
                name: 'Chiller Cooling System',
                description: 'Temperature control for high-temp processes',
                cost: 50000,
                monthlyMaint: 2000,
                benefit: 'Unlocks HIGHTEMP recipes, thermal stability'
            },
            {
                id: 'abatement',
                name: 'Exhaust Gas Abatement',
                description: 'Environmental compliance & waste processing',
                cost: 45000,
                monthlyMaint: 2500,
                benefit: 'Process exotic gases safely, +eco-friendly'
            }
        ];

        // ===== UTILITY FUNCTIONS =====
        function formatCash(amount) {
            return '$' + Math.floor(amount).toLocaleString();
        }

        function log(msg, type = 'info') {
            const logEl = document.getElementById('eventLog');
            const entry = document.createElement('div');
            entry.className = `log-entry ${type}`;
            const time = new Date().toLocaleTimeString();
            entry.innerHTML = `<span class="log-time">[${game.month}]</span> ${msg}`;
            logEl.insertBefore(entry, logEl.firstChild);
            if (logEl.children.length > 50) logEl.removeChild(logEl.lastChild);
        }

        function addCash(amount) {
            game.cash += amount;
            if (amount > 0) {
                game.totalRevenue += amount;
                game.monthlyRevenue += amount;
            } else {
                game.totalExpenses += Math.abs(amount);
            }
            updateUI();
            if (game.cash <= 0) triggerGameOver();
        }

        function canAfford(cost) {
            return game.cash >= cost;
        }

        function closeModal() {
            document.querySelectorAll('.modal').forEach(m => m.classList.remove('active'));
        }

        // ===== PUMP MANAGEMENT =====
        function createPump(type) {
            return {
                id: game.pumpIDCounter++,
                type: type,
                health: pumpTypes[type].baseHealth,
                age: 0,
                failed: false,
                x: Math.random() * 500 + 50,
                y: Math.random() * 200 + 50
            };
        }

        function buyTurboPump() {
            const cost = pumpTypes.TURBOMOLECULAR.cost;
            if (!canAfford(cost)) {
                log('Insufficient funds for Turbomolecular Pump', 'error');
                return;
            }
            const pump = createPump('TURBOMOLECULAR');
            game.pumps.push(pump);
            addCash(-cost);
            game.monthlyUpgrades += cost;
            log(`Purchased Turbomolecular Pump #${pump.id}`, 'success');
            updateUI();
        }

        function buyRotaryPump() {
            const cost = pumpTypes.ROTARY_VANE.cost;
            if (!canAfford(cost)) {
                log('Insufficient funds for Rotary Vane Pump', 'error');
                return;
            }
            const pump = createPump('ROTARY_VANE');
            game.pumps.push(pump);
            addCash(-cost);
            game.monthlyUpgrades += cost;
            log(`Purchased Rotary Vane Pump #${pump.id}`, 'success');
            updateUI();
        }

        function repairAllPumps() {
            const failedCount = game.pumps.filter(p => p.failed).length;
            if (failedCount === 0) {
                log('No failed pumps to repair', 'warning');
                return;
            }
            const costPerPump = 5000;
            const totalCost = failedCount * costPerPump;
            if (!canAfford(totalCost)) {
                log('Insufficient funds for repairs', 'error');
                return;
            }
            game.pumps.forEach(p => {
                if (p.failed) {
                    p.failed = false;
                    p.health = 100;
                    p.age = 0;
                }
            });
            addCash(-totalCost);
            game.monthlyUpgrades += totalCost;
            log(`Repaired ${failedCount} pumps for ${formatCash(totalCost)}`, 'success');
            updateUI();
        }

        function getWorkingCapacity() {
            return game.pumps.filter(p => !p.failed).reduce((sum, p) => sum + pumpTypes[p.type].capacity, 0);
        }

        function getTotalCapacity() {
            return game.pumps.reduce((sum, p) => sum + pumpTypes[p.type].capacity, 0);
        }

        function getWorkingPumpCount() {
            return game.pumps.filter(p => !p.failed).length;
        }

        // ===== CONTRACT MANAGEMENT =====
        function acceptContract(templateIndex) {
            const template = contractLibrary[templateIndex];
            
            // Check requirements
            if (template.requiresHighVac && !game.equipment.highVac.owned) {
                log('High-Vac equipment required for ' + template.customer, 'error');
                return;
            }
            if (template.requiresCooling && !game.equipment.cooling.owned) {
                log('Cooling system required for ' + template.customer, 'error');
                return;
            }

            const contract = {
                id: game.contractIDCounter++,
                customer: template.customer,
                wafersPerMonth: template.wafersPerMonth,
                monthlyFee: template.monthlyFee,
                monthsRemaining: template.deadline,
                penalty: template.penalty,
                recipe: template.recipe,
                wafersProcessed: 0,
                penalties: 0
            };

            game.contracts.push(contract);
            log(`New contract: ${contract.customer} (${contract.wafersPerMonth} wafers/mo)`, 'success');
            updateUI();
        }

        function processPenalties() {
            game.contracts.forEach(contract => {
                const recipe = recipes[contract.recipe];
                const workingCapacity = getWorkingCapacity();

                // Check if contract can be fulfilled
                if (workingCapacity < recipe.pumpingReq) {
                    contract.penalties += contract.penalty;
                    log(`${contract.customer}: PENALTY - Insufficient capacity`, 'error');
                }
            });

            if (game.contracts.some(c => c.penalties > 0)) {
                const totalPenalties = game.contracts.reduce((sum, c) => sum + c.penalties, 0);
                addCash(-totalPenalties);
                game.monthlyUpgrades += totalPenalties;
            }
        }

        function endContracts() {
            game.contracts = game.contracts.filter(c => {
                c.monthsRemaining--;
                if (c.monthsRemaining <= 0) {
                    log(`Contract ended: ${c.customer}`, 'info');
                    return false;
                }
                return true;
            });
        }

        // ===== CASSETTE MANAGEMENT =====
        function addCassette() {
            if (game.cassettes.length >= 10) {
                log('Maximum cassette queue reached', 'warning');
                return;
            }
            const cassette = {
                id: game.cassetteIDCounter++,
                recipe: game.currentRecipe,
                progress: 0,
                totalMonths: recipes[game.currentRecipe].duration,
                wafers: 1,
                quality: 100
            };
            game.cassettes.push(cassette);
            log(`Added cassette: ${recipes[cassette.recipe].name}`, 'success');
            updateUI();
        }

        function setRecipe(recipeName) {
            game.currentRecipe = recipeName;
            document.querySelectorAll('.recipe-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`recipe-${recipeName}`).classList.add('active');
        }

        function processCassettes() {
            const workingCapacity = getWorkingCapacity();
            
            game.cassettes = game.cassettes.filter(cassette => {
                const recipe = recipes[cassette.recipe];
                
                // Check if recipe requirements are met
                let canProcess = workingCapacity >= recipe.pumpingReq;
                
                if (recipe.requiresHighVac && !game.equipment.highVac.owned) canProcess = false;
                if (recipe.requiresCooling && !game.equipment.cooling.owned) canProcess = false;

                if (canProcess) {
                    cassette.progress++;
                    if (cassette.progress >= cassette.totalMonths) {
                        const revenue = cassette.wafers * recipe.revenuePerWafer * recipe.qualityBonus;
                        addCash(revenue);
                        game.monthlyRevenue += revenue;
                        log(`Cassette #${cassette.id} complete: ${formatCash(revenue)}`, 'success');
                        return false; // Remove completed cassette
                    }
                } else {
                    log(`Cassette #${cassette.id}: Insufficient resources for ${recipe.name}`, 'warning');
                }

                return true; // Keep cassette
            });
        }

        // ===== PUMP AGING & FAILURE =====
        function updatePumpHealth() {
            game.pumps.forEach(pump => {
                if (!pump.failed) {
                    pump.age++;
                    // Health degrades over time
                    const ageDecay = (pump.age / pumpTypes[pump.type].lifespan) * 30;
                    pump.health = Math.max(0, pumpTypes[pump.type].baseHealth - ageDecay);

                    // Failure chance increases with age
                    const failureChance = pumpTypes[pump.type].failureRate + (pump.age / pumpTypes[pump.type].lifespan) * 0.05;
                    if (Math.random() < failureChance) {
                        pump.failed = true;
                        log(`❌ Pump #${pump.id} FAILED`, 'error');
                    }
                }
            });
        }

        // ===== EQUIPMENT UPGRADES =====
        function buyEquipment(equipmentId) {
            const equipment = game.equipment[equipmentId];
            if (equipment.owned) {
                log('Equipment already owned', 'warning');
                return;
            }
            if (!canAfford(equipment.cost)) {
                log('Insufficient funds', 'error');
                return;
            }
            equipment.owned = true;
            addCash(-equipment.cost);
            game.monthlyUpgrades += equipment.cost;
            const name = equipmentCatalog.find(e => e.id === equipmentId)?.name || 'Equipment';
            log(`Purchased: ${name}`, 'success');
            closeModal();
            updateUI();
        }

        // ===== MAINTENANCE COSTS =====
        function applyMaintenanceCosts() {
            // Pump maintenance
            let pumpMaint = 0;
            game.pumps.forEach(pump => {
                if (!pump.failed) {
                    pumpMaint += pumpTypes[pump.type].maintenance;
                }
            });
            game.monthlyMaintenance += pumpMaint;

            // Equipment maintenance
            let equipMaint = 0;
            Object.keys(game.equipment).forEach(key => {
                if (game.equipment[key].owned) {
                    equipMaint += game.equipment[key].maint;
                }
            });
            game.monthlySystemMaint += equipMaint;

            const totalMaint = pumpMaint + equipMaint;
            addCash(-totalMaint);
        }

        // ===== MONTHLY SIMULATION =====
        function simulateMonth() {
            if (game.gameOver || game.paused) return;

            // 1. Update pump health
            updatePumpHealth();

            // 2. Process cassettes
            processCassettes();

            // 3. Apply contract penalties
            processPenalties();

            // 4. Apply monthly revenue from contracts
            let contractRevenue = 0;
            game.contracts.forEach(c => {
                contractRevenue += c.monthlyFee;
            });
            if (contractRevenue > 0) {
                addCash(contractRevenue);
                game.monthlyRevenue += contractRevenue;
            }

            // 5. Apply maintenance costs
            applyMaintenanceCosts();

            // 6. End contracts
            endContracts();

            // 7. Reset monthly counters
            game.month++;
            game.monthlyRevenue = 0;
            game.monthlyMaintenance = 0;
            game.monthlySystemMaint = 0;
            game.monthlyUpgrades = 0;

            updateUI();
        }

        // ===== UI UPDATES =====
        function updateUI() {
            updateHeader();
            updateFinancialPanel();
            updatePumpsList();
            updateContractsList();
            updateCassettesList();
            updateEquipmentStatus();
            updatePumpMap();
        }

        function updateHeader() {
            document.getElementById('cashDisplay').textContent = formatCash(game.cash);
            document.getElementById('monthDisplay').textContent = game.month;
            
            const monthlyRevenue = game.monthlyRevenue + game.contracts.reduce((sum, c) => sum + c.monthlyFee, 0);
            document.getElementById('revenueDisplay').textContent = formatCash(monthlyRevenue);
            
            const monthlyCosts = game.monthlyMaintenance + game.monthlySystemMaint + game.monthlyUpgrades;
            document.getElementById('costsDisplay').textContent = formatCash(monthlyCosts);
            
            const working = getWorkingPumpCount();
            const total = game.pumps.length;
            document.getElementById('pumpStatusDisplay').textContent = `${working}/${total}`;
            document.getElementById('contractsDisplay').textContent = game.contracts.length;
        }

        function updateFinancialPanel() {
            document.getElementById('finCash').textContent = formatCash(game.cash);
            document.getElementById('finRevenue').textContent = formatCash(game.totalRevenue);
            document.getElementById('finExpenses').textContent = formatCash(game.totalExpenses);
            const netProfit = game.totalRevenue - game.totalExpenses;
            const netEl = document.getElementById('finNet');
            netEl.textContent = formatCash(netProfit);
            netEl.className = 'financial-amount' + (netProfit < 0 ? ' negative' : '');

            document.getElementById('monthRevenue').textContent = formatCash(game.monthlyRevenue);
            document.getElementById('monthMaintenance').textContent = formatCash(game.monthlyMaintenance);
            document.getElementById('monthSystemMaint').textContent = formatCash(game.monthlySystemMaint);
            document.getElementById('monthUpgrades').textContent = formatCash(game.monthlyUpgrades);
        }

        function updatePumpsList() {
            const list = document.getElementById('pumpsList');
            if (game.pumps.length === 0) {
                list.innerHTML = '<div style="color: #888; font-size: 10px;">No pumps yet</div>';
                return;
            }

            list.innerHTML = game.pumps.map(pump => {
                const type = pumpTypes[pump.type];
                const healthPercent = pump.health;
                let healthClass = '';
                if (healthPercent < 30) healthClass = 'critical-health';
                else if (healthPercent < 60) healthClass = 'warning-health';

                return `
                    <div class="pump-item ${healthClass}">
                        <strong>${type.symbol} #${pump.id}</strong> ${pump.failed ? '❌ FAILED' : '✓'}
                        <div class="pump-bar">
                            <div class="bar">
                                <div class="bar-fill ${pump.failed ? 'critical' : healthPercent < 60 ? 'warning' : ''}" 
                                     style="width: ${pump.health}%"></div>
                            </div>
                        </div>
                        <div style="font-size: 9px; color: #aaa; margin-top: 2px;">
                            Age: ${pump.age}mo | Health: ${Math.round(pump.health)}% | Cap: ${type.capacity}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function updateContractsList() {
            const list = document.getElementById('contractList');
            if (game.contracts.length === 0) {
                list.innerHTML = '<div style="color: #888; font-size: 10px;">No active contracts</div>';
                return;
            }

            list.innerHTML = game.contracts.map(c => {
                const recipe = recipes[c.recipe];
                return `
                    <div class="contract-item">
                        <div class="contract-customer">${c.customer}</div>
                        <div class="contract-terms">
                            📦 ${c.wafersPerMonth} wafers/month<br>
                            💰 ${formatCash(c.monthlyFee)}/month<br>
                            ⏳ ${c.monthsRemaining} months remaining<br>
                            🔬 Recipe: ${recipe.name}
                            ${c.penalties > 0 ? `<br>⚠️ Penalties: ${formatCash(c.penalties)}` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function updateCassettesList() {
            const list = document.getElementById('cassetteList');
            if (game.cassettes.length === 0) {
                list.innerHTML = '<div style="color: #888; font-size: 10px;">No cassettes in queue</div>';
                return;
            }

            list.innerHTML = game.cassettes.map(c => {
                const recipe = recipes[c.recipe];
                const progressPercent = (c.progress / c.totalMonths) * 100;
                const isActive = game.cassettes.indexOf(c) === 0;
                
                return `
                    <div class="cassette-item ${isActive ? 'active' : ''}">
                        <div class="cassette-name">#${c.id}: ${recipe.name}</div>
                        <div class="cassette-progress">Progress: ${c.progress}/${c.totalMonths} months</div>
                        <div class="bar">
                            <div class="bar-fill" style="width: ${progressPercent}%"></div>
                        </div>
                        <div style="font-size: 9px; color: #aaa; margin-top: 3px;">
                            Wafers: ${c.wafers} | Quality: ${c.quality}%
                        </div>
                    </div>
                `;
            }).join('');
        }
function updateEquipmentStatus() {
            const list = document.getElementById('equipmentStatus');
            const owned = Object.keys(game.equipment).filter(k => game.equipment[k].owned);
            
            if (owned.length === 0) {
                list.innerHTML = '<div style="color: #888; font-size: 10px;">No system equipment</div>';
                return;
            }

            list.innerHTML = owned.map(key => {
                const eq = equipmentCatalog.find(e => e.id === key);
                return `
                    <div class="pump-item" style="border-color: #ffaa00;">
                        <strong style="color: #ffaa00;">✓ ${eq.name}</strong>
                        <div style="font-size: 9px; color: #aaa; margin-top: 3px;">
                            Maint: ${formatCash(eq.monthlyMaint)}/mo
                        </div>
                    </div>
                `;
            }).join('');
        }

        function updatePumpMap() {
            const container = document.getElementById('pumpMapContainer');
            
            if (game.pumps.length === 0) {
                container.innerHTML = '<div style="color: #666; text-align: center; padding: 40px; font-size: 11px;">No pumps deployed yet. Build some pumps to get started.</div>';
                return;
            }

            container.innerHTML = game.pumps.map(pump => {
                const type = pumpTypes[pump.type];
                const status = pump.failed ? 'failed' : 'working';
                return `
                    <div class="pump-on-map ${status}" style="left: ${pump.x}px; top: ${pump.y}px;">
                        <svg class="pump-icon" viewBox="0 0 100 100">
                            ${getPumpSVG(pump.type, status)}
                        </svg>
                        <div class="pump-label">${type.symbol} #${pump.id}</div>
                        <div class="pump-status-dot ${status}"></div>
                    </div>
                `;
            }).join('');
        }

        function getPumpSVG(type, status) {
            if (type === 'TURBOMOLECULAR') {
                return `
                    <circle cx="50" cy="50" r="40" fill="none" stroke="${status === 'failed' ? '#ff4444' : '#00ff88'}" stroke-width="3"/>
                    <path d="M 50 20 L 70 50 L 50 80 L 30 50 Z" fill="${status === 'failed' ? '#ff444433' : '#00ff8833'}" stroke="${status === 'failed' ? '#ff4444' : '#00ff88'}" stroke-width="2"/>
                    <circle cx="50" cy="50" r="15" fill="${status === 'failed' ? '#ff4444' : '#00ff88'}"/>
                `;
            } else {
                return `
                    <rect x="20" y="20" width="60" height="60" fill="none" stroke="${status === 'failed' ? '#ff4444' : '#00ff88'}" stroke-width="3" rx="8"/>
                    <circle cx="50" cy="35" r="8" fill="${status === 'failed' ? '#ff4444' : '#00ff88'}"/>
                    <circle cx="50" cy="65" r="8" fill="${status === 'failed' ? '#ff4444' : '#00ff88'}"/>
                    <line x1="50" y1="43" x2="50" y2="57" stroke="${status === 'failed' ? '#ff4444' : '#00ff88'}" stroke-width="2"/>
                `;
            }
        }

        function showEquipmentMenu() {
            const modal = document.getElementById('equipmentModal');
            const options = document.getElementById('equipmentOptions');
            
            options.innerHTML = equipmentCatalog.map(eq => {
                const owned = game.equipment[eq.id].owned;
                const canBuy = canAfford(eq.cost);
                
                return `
                    <div class="equipment-option" style="${owned ? 'opacity: 0.5;' : ''}">
                        <div class="equipment-name">
                            ${eq.name}
                            ${owned ? '<span class="vendor-badge">OWNED</span>' : ''}
                        </div>
                        <div class="equipment-specs">
                            ${eq.description}<br>
                            Cost: <strong>${formatCash(eq.cost)}</strong> | Maint: ${formatCash(eq.monthlyMaint)}/mo<br>
                            <em>${eq.benefit}</em>
                        </div>
                        <button class="button" 
                                onclick="buyEquipment('${eq.id}')"
                                ${owned || !canBuy ? 'disabled' : ''}>
                            ${owned ? 'OWNED' : canBuy ? 'BUY NOW' : 'INSUFFICIENT FUNDS'}
                        </button>
                    </div>
                `;
            }).join('');

            modal.classList.add('active');
        }

        function showUpgradesMenu() {
            const modal = document.getElementById('upgradesModal');
            const options = document.getElementById('upgradesOptions');
            
            options.innerHTML = `
                <div class="equipment-option">
                    <div class="equipment-name">🔬 Available Contracts</div>
                    <div class="equipment-specs" style="margin-bottom: 8px;">
                        Sign contracts with major semiconductor manufacturers for guaranteed revenue.
                    </div>
                </div>
                ${contractLibrary.map((contract, idx) => {
                    const exists = game.contracts.some(c => c.customer === contract.customer);
                    return `
                        <div class="equipment-option">
                            <div class="equipment-name">${contract.customer}</div>
                            <div class="equipment-specs">
                                📦 ${contract.wafersPerMonth} wafers/month<br>
                                💰 ${formatCash(contract.monthlyFee)}/month for ${contract.deadline} months<br>
                                ⚠️ Penalty: ${formatCash(contract.penalty)} if unfulfilled<br>
                                🔬 Recipe: ${recipes[contract.recipe].name}
                                ${contract.requiresHighVac ? '<br>📋 Requires: High-Vac Equipment' : ''}
                                ${contract.requiresCooling ? '<br>📋 Requires: Cooling System' : ''}
                            </div>
                            <button class="button" 
                                    onclick="acceptContract(${idx})"
                                    ${exists ? 'disabled' : ''}>
                                ${exists ? 'ALREADY SIGNED' : 'SIGN CONTRACT'}
                            </button>
                        </div>
                    `;
                }).join('')}
            `;

            modal.classList.add('active');
        }

        function showRepairMenu() {
            const modal = document.getElementById('repairModal');
            const options = document.getElementById('repairOptions');
            
            const failedCount = game.pumps.filter(p => p.failed).length;
            const costPer = 5000;
            const totalCost = failedCount * costPer;
            const canRepair = canAfford(totalCost) && failedCount > 0;

            options.innerHTML = `
                <div class="equipment-option">
                    <div class="equipment-name">🔧 Pump Repair Service</div>
                    <div class="equipment-specs">
                        Failed Pumps: <strong>${failedCount}</strong><br>
                        Cost per pump: ${formatCash(costPer)}<br>
                        Total cost: <strong>${formatCash(totalCost)}</strong><br>
                        <br>
                        Emergency repairs restore failed pumps to 100% health and reset their age counter.
                    </div>
                    <button class="button danger" 
                            onclick="repairAllPumps()"
                            ${!canRepair ? 'disabled' : ''}>
                        ${failedCount === 0 ? 'NO FAILED PUMPS' : canRepair ? 'AUTHORIZE REPAIRS' : 'INSUFFICIENT FUNDS'}
                    </button>
                </div>
            `;

            modal.classList.add('active');
        }

        function togglePause() {
            game.paused = !game.paused;
            document.getElementById('pauseLabel').textContent = game.paused ? 'RESUME' : 'PAUSE';
            log(game.paused ? 'Game PAUSED' : 'Game RESUMED', 'info');
        }

        function triggerGameOver() {
            game.gameOver = true;
            const modal = document.getElementById('gameOverModal');
            const msg = document.getElementById('gameOverMessage');
            
            const months = game.month;
            const profit = game.totalRevenue - game.totalExpenses;
            
            msg.innerHTML = `
                You've run out of cash after <strong>${months} months</strong> of operation.<br>
                <br>
                Total Revenue: <strong style="color: #00ff88;">${formatCash(game.totalRevenue)}</strong><br>
                Total Expenses: <strong style="color: #ff6666;">${formatCash(game.totalExpenses)}</strong><br>
                Final Balance: <strong style="color: ${profit >= 0 ? '#00ff88' : '#ff6666'}">${formatCash(profit)}</strong>
            `;
            
            modal.classList.add('active');
            log('BANKRUPTCY - Game Over', 'error');
        }

        // ===== KEYBOARD SHORTCUTS =====
        document.addEventListener('keydown', (e) => {
            if (game.gameOver) return;
            
            switch(e.key.toUpperCase()) {
                case 'T':
                    buyTurboPump();
                    break;
                case 'R':
                    buyRotaryPump();
                    break;
                case 'F':
                    repairAllPumps();
                    break;
                case 'E':
                    showEquipmentMenu();
                    break;
                case 'C':
                    showUpgradesMenu();
                    break;
                case ' ':
                    e.preventDefault();
                    togglePause();
                    break;
            }
        });

        // ===== GAME LOOP =====
        setInterval(() => {
            simulateMonth();
        }, 2000); // Simulate 1 month every 2 seconds

        // ===== INITIALIZATION =====
        function init() {
            setRecipe('STANDARD');
            log('Semiconductor Fab Pump Tycoon started', 'success');
            log('Beginning with $500,000 capital', 'info');
            log('Press T to buy Turbo pump, R for Rotary pump', 'info');
            log('Press E for equipment, C for contracts, SPACE to pause', 'info');
            updateUI();
        }

        init();
    </script>
</body>
</html>



