<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Semiconductor Fab Pump Tycoon - Complete</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 100%);
            color: #00ff88;
            overflow: hidden;
            height: 100vh;
        }

        .container {
            display: grid;
            grid-template-columns: 1.2fr 1.8fr 1.2fr 1.2fr;
            grid-template-rows: auto 1fr 1fr;
            gap: 8px;
            padding: 8px;
            height: 100vh;
            width: 100%;
        }

        header {
            grid-column: 1 / -1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(90deg, #0a0e27, #1a1f3a);
            border: 2px solid #00ff88;
            border-radius: 8px;
            padding: 12px 20px;
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
        }

        .header-title {
            font-size: 18px;
            font-weight: bold;
            color: #00ff88;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .game-stats {
            display: flex;
            gap: 40px;
            font-size: 13px;
        }

        .stat {
            display: flex;
            flex-direction: column;
            text-align: right;
        }

        .stat-label {
            color: #888;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value {
            color: #00ff88;
            font-weight: bold;
            font-size: 14px;
        }

        .stat-value.warning {
            color: #ffaa00;
        }

        .stat-value.critical {
            color: #ff4444;
        }

        .panel {
            background: linear-gradient(135deg, rgba(26, 31, 58, 0.8), rgba(15, 20, 38, 0.8));
            border: 2px solid #00ff88;
            border-radius: 8px;
            padding: 12px;
            overflow-y: auto;
            font-size: 11px;
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.2);
        }

        .panel::-webkit-scrollbar {
            width: 6px;
        }

        .panel::-webkit-scrollbar-track {
            background: #0a0e27;
        }

        .panel::-webkit-scrollbar-thumb {
            background: #00ff88;
            border-radius: 3px;
        }

        .section-title {
            color: #00ff88;
            font-weight: bold;
            margin-bottom: 8px;
            padding-bottom: 6px;
            border-bottom: 2px solid #00ff88;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .subsection {
            margin-bottom: 10px;
        }

        .pump-item {
            background: rgba(15, 20, 38, 0.6);
            border: 1px solid #00aa66;
            border-radius: 4px;
            padding: 8px;
            margin-bottom: 6px;
            font-size: 10px;
        }

        .pump-item.critical-health {
            border-color: #ff4444;
            background: rgba(255, 68, 68, 0.1);
        }

        .pump-item.warning-health {
            border-color: #ffaa00;
            background: rgba(255, 170, 0, 0.1);
        }

        .pump-bar {
            display: flex;
            gap: 4px;
            margin-top: 4px;
            font-size: 9px;
        }

        .bar {
            flex: 1;
            background: #0a0e27;
            border: 1px solid #00ff88;
            border-radius: 2px;
            height: 14px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #00ff88, #00cc66);
            transition: width 0.2s;
        }

        .bar-fill.warning {
            background: linear-gradient(90deg, #ffaa00, #ff6600);
        }

        .bar-fill.critical {
            background: linear-gradient(90deg, #ff4444, #ff0000);
        }

        .financial-summary {
            background: rgba(0, 40, 20, 0.2);
            border: 1px solid #00aa66;
            border-radius: 4px;
            padding: 8px;
            margin-top: 6px;
        }

        .financial-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 3px;
            font-size: 10px;
        }

        .financial-label {
            color: #888;
        }

        .financial-amount {
            color: #00ff88;
            font-weight: bold;
        }

        .financial-amount.negative {
            color: #ff6666;
        }

        .contract-item {
            background: rgba(0, 40, 80, 0.2);
            border: 1px solid #0088ff;
            border-radius: 4px;
            padding: 8px;
            margin-bottom: 6px;
        }

        .contract-customer {
            color: #00ff88;
            font-weight: bold;
            font-size: 10px;
            margin-bottom: 3px;
        }

        .contract-terms {
            color: #aaa;
            font-size: 9px;
            line-height: 1.4;
        }

        .cassette-item {
            background: rgba(80, 40, 0, 0.2);
            border: 1px solid #ffaa00;
            border-radius: 4px;
            padding: 8px;
            margin-bottom: 6px;
        }

        .cassette-item.active {
            border-color: #00ff88;
            background: rgba(0, 255, 136, 0.1);
        }

        .cassette-name {
            color: #ffaa00;
            font-weight: bold;
            font-size: 10px;
            margin-bottom: 3px;
        }

        .cassette-progress {
            color: #aaa;
            font-size: 9px;
            margin-bottom: 3px;
        }

        .recipe-selector {
            display: flex;
            gap: 6px;
            margin-bottom: 8px;
        }

        .recipe-btn {
            flex: 1;
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid #00ff88;
            color: #00ff88;
            padding: 6px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 9px;
            font-weight: bold;
            transition: all 0.2s;
        }

        .recipe-btn:hover {
            background: rgba(0, 255, 136, 0.3);
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }

        .recipe-btn.active {
            background: rgba(0, 255, 136, 0.4);
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.7);
        }

        .button {
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid #00ff88;
            color: #00ff88;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-family: inherit;
            font-size: 10px;
            font-weight: bold;
            transition: all 0.2s;
            width: 100%;
            margin-top: 4px;
        }

        .button:hover {
            background: rgba(0, 255, 136, 0.3);
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }

        .button.secondary {
            background: rgba(100, 150, 255, 0.1);
            border-color: #6688ff;
            color: #6688ff;
        }

        .button.secondary:hover {
            background: rgba(100, 150, 255, 0.3);
            box-shadow: 0 0 10px rgba(100, 150, 255, 0.5);
        }

        .button.danger {
            background: rgba(255, 100, 100, 0.1);
            border-color: #ff6666;
            color: #ff6666;
        }

        .button.danger:hover {
            background: rgba(255, 100, 100, 0.3);
            box-shadow: 0 0 10px rgba(255, 100, 100, 0.5);
        }

        .button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* PUMP MAP STYLING */
        .pump-map-container {
            position: relative;
            background: #0a0a0a;
            border: 1px solid #00aa66;
            border-radius: 4px;
            height: 100%;
            overflow: hidden;
            margin-top: 8px;
        }

        .pump-on-map {
            position: absolute;
            width: 70px;
            height: 70px;
            border: 2px solid #00aa66;
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 8px;
            cursor: pointer;
            transition: all 0.2s;
            background: rgba(10, 20, 40, 0.7);
        }

        .pump-on-map.working {
            border-color: #00ff88;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.6);
        }

        .pump-on-map.failed {
            border-color: #ff4444;
            box-shadow: 0 0 10px rgba(255, 68, 68, 0.6);
            background: rgba(255, 68, 68, 0.15);
        }

        .pump-on-map:hover {
            transform: scale(1.1);
        }

        .pump-icon {
            width: 45px;
            height: 45px;
            margin-bottom: 2px;
        }

        .pump-label {
            font-weight: bold;
            color: #fff;
            font-size: 7px;
            text-align: center;
        }

        .pump-status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-top: 2px;
        }

        .pump-status-dot.working {
            background: #00ff88;
            box-shadow: 0 0 4px #00ff88;
        }

        .pump-status-dot.failed {
            background: #ff4444;
            box-shadow: 0 0 4px #ff4444;
        }

        .log-entry {
            padding: 6px;
            margin-bottom: 4px;
            border-left: 2px solid #00ff88;
            padding-left: 8px;
            font-size: 9px;
            color: #aaa;
            line-height: 1.3;
        }

        .log-entry.error {
            border-left-color: #ff4444;
            color: #ff6666;
        }

        .log-entry.success {
            border-left-color: #00ff88;
            color: #00ff88;
        }

        .log-entry.warning {
            border-left-color: #ffaa00;
            color: #ffaa00;
        }

        .log-time {
            color: #666;
            font-size: 8px;
            display: inline;
            margin-right: 4px;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: linear-gradient(135deg, #1a1f3a 0%, #0f1426 100%);
            border: 3px solid #00ff88;
            padding: 20px;
            max-width: 600px;
            max-height: 80vh;
            overflow-y: auto;
            border-radius: 8px;
            box-shadow: 0 0 30px rgba(0, 255, 136, 0.5);
        }

        .modal-title {
            color: #00ff88;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 12px;
            border-bottom: 2px solid #00ff88;
            padding-bottom: 8px;
        }

        .equipment-option {
            background: rgba(0, 50, 100, 0.2);
            border: 1px solid #0088ff;
            border-radius: 4px;
            padding: 10px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .equipment-option:hover {
            background: rgba(0, 100, 200, 0.3);
            border-color: #00ff88;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
        }

        .equipment-name {
            color: #00ff88;
            font-weight: bold;
            font-size: 11px;
            margin-bottom: 3px;
        }

        .equipment-specs {
            color: #aaa;
            font-size: 9px;
            margin-bottom: 3px;
            line-height: 1.3;
        }

        .vendor-badge {
            display: inline-block;
            background: rgba(255, 170, 0, 0.2);
            border: 1px solid #ffaa00;
            color:            #ffaa00;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 8px;
            margin-left: 4px;
        }

        .game-over {
            text-align: center;
            color: #ff4444;
        }

        .game-over h2 {
            color: #ff4444;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .game-over p {
            color: #aaa;
            margin-bottom: 8px;
            font-size: 11px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 6px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <header>
            <div class="header-title">
                ⚙️ SEMICONDUCTOR FAB PUMP TYCOON
            </div>
            <div class="game-stats">
                <div class="stat">
                    <div class="stat-label">Cash</div>
                    <div class="stat-value" id="cashDisplay">$500,000</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Month</div>
                    <div class="stat-value" id="monthDisplay">1</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Revenue/Mo</div>
                    <div class="stat-value" id="revenueDisplay">$0</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Costs/Mo</div>
                    <div class="stat-value" id="costsDisplay">$0</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Working Pumps</div>
                    <div class="stat-value" id="pumpStatusDisplay">0/0</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Active Contracts</div>
                    <div class="stat-value" id="contractsDisplay">0</div>
                </div>
            </div>
        </header>

        <!-- FINANCIAL PANEL (left column, row 1) -->
        <div class="panel" style="grid-column: 1; grid-row: 2;">
            <div class="section-title">💰 Financial Status</div>
            <div class="financial-summary">
                <div class="financial-item">
                    <span class="financial-label">Starting Cash</span>
