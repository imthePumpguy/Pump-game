            <div id="equipmentStatus"></div>
        </div>

        <!-- EVENT LOG (spans bottom) -->
        <div class="panel" style="grid-column: 1 / -1; grid-row: 3;">
            <div class="section-title">📜 Event Log</div>
            <div id="eventLog" style="max-height: 120px; overflow-y: auto;"></div>
        </div>
