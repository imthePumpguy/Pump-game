                </div>
            </div>

            <div class="section-title" style="margin-top: 12px;">🔧 Quick Actions</div>
            <button class="button secondary" onclick="showEquipmentMenu()">Buy Equipment</button>
            <button class="button secondary" onclick="showUpgradesMenu()">System Upgrades</button>
            <button class="button danger" onclick="showRepairMenu()">Emergency Repair</button>
            <button class="button" onclick="togglePause()">⏸️ <span id="pauseLabel">PAUSE</span></button>
        </div>

        <!-- PUMP SYSTEM MAP (middle column, rows 1-2) -->
        <div class="panel" style="grid-column: 2; grid-row: 2 / 4;">
            <div class="section-title">🗺️ Pump System Map</div>
            <div class="pump-map-container" id="pumpMapContainer"></div>
        </div>

        <!-- CONTRACTS & CASSETTES (right column, row 1) -->
        <div class="panel" style="grid-column: 3; grid-row: 2;">
